# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxx.mongodb.net/dbname

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Auth (single admin) ---
AUTH_SECRET=generate-with-node-crypto-randomBytes-32-hex
ADMIN_USERNAME=admin
# bcrypt hash of your password, hex-encoded (bcrypt's $ chars break .env expansion)
ADMIN_PASSWORD_HASH_HEX=hex-of-bcrypt-hash
