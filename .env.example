# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxx.mongodb.net/dbname

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Auth (single admin) ---
AUTH_SECRET=generate-with-node-crypto-randomBytes-32-hex
ADMIN_USERNAME=admin
# bcrypt hash used as the initial/fallback admin password, hex-encoded
# (bcrypt's $ chars break .env expansion). The active hash is stored in the
# DB and editable from /admin/settings — run `npm run set-admin-password` to
# bootstrap it (defaults to ADMIN_PASSWORD below, or "Patake98").
ADMIN_PASSWORD_HASH_HEX=hex-of-bcrypt-hash
ADMIN_PASSWORD=
